SERVER_HOST=0.0.0.0
SERVER_PORT=11432

DATABASE_URL=postgres://etsubi:secret@localhost:11342/etsubi

DATABASE_NAME=etsubi
DATABASE_USER=etsubi
DATABASE_PASSWORD=secret
DATABASE_PORT=11342

JWT_KEY=change-me-in-production
JWT_EXPIRY_HOURS=24

CORS_ALLOWED_ORIGINS=http://localhost:12321,http://127.0.0.1:12321,http://localhost:22321,http://127.0.0.1:22321

TRANSLATION_PROVIDER=deepseek
TRANSLATION_MODEL=deepseek-flash
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com/chat/completions
TRANSLATION_TIMEOUT_SECS=30

OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:11432/api/v1/auth/oauth/callback
OAUTH_ISSUER_URL=https://accounts.google.com

# Mail (xác nhận email, quên mật khẩu) gửi qua Resend. Để trống key thì backend chỉ ghi mail ra log.
RESEND_API_KEY=
MAIL_FROM="Etsubi <no-reply@etsubi.net>"
MAIL_REPLY_TO=contact@etsubi.net
# Hộp thư đội kiểm duyệt nhận báo cáo vi phạm (bài viết, bình luận, người dùng).
REPORT_EMAIL=contact@etsubi.net
# Địa chỉ web dùng để dựng link trong mail.
APP_BASE_URL=http://localhost:22321
